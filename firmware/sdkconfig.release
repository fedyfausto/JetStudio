# Release profile (editor: Build/Flash "Release"), applied on top of sdkconfig.defaults
# by the nano_esp32_release environment. No console, logs, statistics or assertions:
# smaller and faster firmware. USB Serial/JTAG stays enabled, so flashing over USB
# keeps working without the BOOT button.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=y
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y
# CONFIG_ESP_ERR_TO_NAME_LOOKUP is not set
