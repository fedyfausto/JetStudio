+// Saturating-subtract blend in RGB565: the source, scaled as in
+// addBlendRGB565, is taken away from the destination and clamped at zero.
+static inline uint16_t subBlendRGB565(uint16_t dst, uint16_t src, uint8_t alpha)
+{
+    const uint32_t a  = (uint32_t)alpha + 1u;
+    const int32_t r = (int32_t)((dst >> 11) & 0x1Fu) - (int32_t)((((src >> 11) & 0x1Fu) * a) >> 8);
+    const int32_t g = (int32_t)((dst >>  5) & 0x3Fu) - (int32_t)((((src >>  5) & 0x3Fu) * a) >> 8);
+    const int32_t b = (int32_t)( dst        & 0x1Fu) - (int32_t)(((( src       & 0x1Fu)) * a) >> 8);
+    return (uint16_t)(((r > 0 ? r : 0) << 11) | ((g > 0 ? g : 0) << 5) | (b > 0 ? b : 0));
+}
+
+// Multiply blend in RGB565. Lower alpha fades the source toward white, so
+// alpha=0 leaves the destination unchanged.
+static inline uint16_t mulBlendRGB565(uint16_t dst, uint16_t src, uint8_t alpha)
+{
+    const uint32_t a  = (uint32_t)alpha + 1u;
+    const uint32_t sr = 0x1Fu - (((0x1Fu - ((src >> 11) & 0x1Fu)) * a) >> 8);
+    const uint32_t sg = 0x3Fu - (((0x3Fu - ((src >>  5) & 0x3Fu)) * a) >> 8);
+    const uint32_t sb = 0x1Fu - (((0x1Fu - ( src        & 0x1Fu)) * a) >> 8);
+    const uint32_t r = (((dst >> 11) & 0x1Fu) * sr + 15u) / 0x1Fu;
+    const uint32_t g = (((dst >>  5) & 0x3Fu) * sg + 31u) / 0x3Fu;
+    const uint32_t b = (( dst        & 0x1Fu) * sb + 15u) / 0x1Fu;
+    return (uint16_t)((r << 11) | (g << 5) | b);
+}
