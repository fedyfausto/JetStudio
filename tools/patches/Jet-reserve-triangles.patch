+void Scene::reserveTriangles(size_t triangles) {
+    renderQueue.reserve(triangles);
+#if TEXTURE_MAPPING
+    textureQueue.reserve(triangles);
+#endif
+    renderBuckets.reserve(triangles);
+    renderOrder.reserve(triangles);
+}
