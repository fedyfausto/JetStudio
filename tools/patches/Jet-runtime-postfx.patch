 void PostFX::applyChromatic(uint16_t* framebuffer) {
     #if POSTFX_CHROMATIC
-    // We'll need a temporary buffer to avoid artifacts
-    uint16_t* temp = new uint16_t[screenWidth * screenHeight];
-    memcpy(temp, framebuffer, screenWidth * screenHeight * sizeof(uint16_t));
-    
+    // Red is taken CHROMATIC_OFFSET pixels to the left and blue as far to the right (clamped at the edges),
+    // green stays: one row of scratch instead of a whole frame allocated per call.
     for (int y = 0; y < screenHeight; y++) {
+        uint16_t* line = framebuffer + y * screenWidth;
+        memcpy(chromaticRow, line, screenWidth * sizeof(uint16_t));
+
         for (int x = 0; x < screenWidth; x++) {
-            uint16_t pixel = temp[y * screenWidth + x];
-            int r = (pixel >> 11) & 0x1F;
-            int g = (pixel >> 5) & 0x3F;
-            int b = pixel & 0x1F;
-            
-            // Offset red and blue channels
-            int rx = x + CHROMATIC_OFFSET;
-            int bx = x - CHROMATIC_OFFSET;
-            
-            if (rx < screenWidth)
-                framebuffer[y * screenWidth + x] = ((r << 11) | (g << 5) | b);
-            if (bx >= 0)
-                framebuffer[y * screenWidth + x] |= b;
-        }
-    }
-    
-    delete[] temp;
+            const int rx = std::max(0, x - CHROMATIC_OFFSET);
+            const int bx = std::min(screenWidth - 1, x + CHROMATIC_OFFSET);
+            line[x] = (uint16_t)((chromaticRow[rx] & 0xF800) | (chromaticRow[x] & 0x07E0) | (chromaticRow[bx] & 0x001F));
+        }
+    }
     #endif
 }
 
