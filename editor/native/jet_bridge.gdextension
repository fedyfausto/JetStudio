[configuration]
entry_symbol = "jet_studio_init"
compatibility_minimum = "4.8"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/libjet_bridge.so"
linux.release.x86_64 = "res://bin/libjet_bridge.so"
windows.debug.x86_64 = "res://bin/jet_bridge.dll"
windows.release.x86_64 = "res://bin/jet_bridge.dll"
macos.debug = "res://bin/libjet_bridge.dylib"
macos.release = "res://bin/libjet_bridge.dylib"
