; Jet Studio is a standalone desktop application built with Godot's UI.
config_version=5

[application]
config/name="Jet Studio"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")
run/use_game_mode=false
config/icon="res://assets/app_icon.png"
boot_splash/bg_color=Color(0.063, 0.078, 0.11, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/boot_splash.png"
boot_splash/stretch_mode=0
boot_splash/use_filter=true

[display]
display_server/driver.linuxbsd="wayland"
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.063, 0.078, 0.11, 1)

[debug]
gdscript/warnings/inference_on_variant=0

[physics]
2d/physics_engine="Dummy"
